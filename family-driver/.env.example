# Copy this file to .env and fill in real values. Never commit .env.
# Tip: run `python run_onboarding.py` for a guided web form that writes this file.

# --- Google (Calendar, Maps Routes, Gmail) ---
# OAuth client for Calendar + Gmail (download from Google Cloud Console,
# APIs & Services > Credentials > OAuth client ID > Desktop app)
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=credentials.json
GOOGLE_OAUTH_TOKEN_FILE=token.json

# Server API key for Maps Routes API (Routes API must be enabled on the project)
GOOGLE_MAPS_API_KEY=your_google_maps_routes_api_key

# --- Microsoft / Outlook (Microsoft Graph) ---
MS_CLIENT_ID=your_azure_app_client_id
MS_TENANT_ID=common
# Optional client secret only if using confidential-client flow; for personal
# accounts the device-code flow (public client) is simplest.
MS_CLIENT_SECRET=
# Outlook calendarId:PersonName pairs. "me:Parent1" = signed-in account's calendar.
OUTLOOK_CALENDAR_MAP=

# --- TeamSnap (optional — a child's sports team) ---
# TeamSnap API v3 uses OAuth2; create an app at https://auth.teamsnap.com
TEAMSNAP_ACCESS_TOKEN=
TEAMSNAP_TEAM_NAME=
# Which child (a NON_DRIVERS name) the team belongs to.
TEAMSNAP_PERSON=

# --- Household config ---
HOME_ADDRESS=123 Your Street, Your City, ST 00000
# How many cars the household shares (the planner currently optimizes one
# shared car; multi-car routing is planned).
NUM_CARS=1
# Drivers = parents who can drive; non-drivers = children / riders.
DRIVERS=Parent1,Parent2
NON_DRIVERS=Child1,Child2,Child3

# Optional explicit email colour per driver (else assigned from a palette).
DRIVER_COLORS=Parent1:#1a73e8,Parent2:#c0392b

# Google Calendar: calendarId:PersonName pairs, comma-separated.
# "primary" = the Google account used for OAuth.
# Find calendar IDs in Google Calendar > Settings > [calendar name] > Calendar ID.
GOOGLE_CALENDAR_MAP=primary:Parent1,spouse@gmail.com:Parent2,abc123@group.calendar.google.com:Family

# Optional: map a title keyword to an address when an event has no location.
# Format: "keyword:address; keyword2:address2"
KNOWN_LOCATIONS=

# --- Email recipients (comma-separated) ---
PLAN_RECIPIENTS=parent1@gmail.com,parent2@gmail.com

# --- Smart replies (optional) ---
# Anthropic API key — lets the planner interpret free-form email replies
# (e.g. "Sanjo has a ride", "Ryan drives Lara to ATA"). Without it, replies
# must use the "Event: answer" keyword format.
ANTHROPIC_API_KEY=

# --- Onboarding web app ---
# Session signing key (auto-generated on first onboarding run if left blank).
FLASK_SECRET_KEY=
